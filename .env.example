# ==============================================================================
# FloodGuard - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' if environment-driven configuration is enabled.
# IMPORTANT: Never commit actual passwords, tokens, or secrets to version control.
# ==============================================================================

# Backend API Configuration
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000

# Database Configuration (MySQL 8.0+ Exclusive)
DB_ENGINE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=floodguard

# ESP32 Bluetooth Serial Configuration
# Update to the virtual COM port assigned to the ESP32 in Device Manager
ESP32_COM_PORT=COM9
ESP32_BAUD_RATE=115200

# Station Monitoring Location (used for ML model inference)
# Coordinates for monitored station (e.g. Coimbatore, Tamil Nadu)
STATION_LATITUDE=10.940896
STATION_LONGITUDE=77.077726
STATION_ELEVATION=318.3

# Frontend Configuration (Vite)
VITE_API_URL=http://127.0.0.1:8000

# External Notifications / SMS Gateway
# ------------------------------------------------------------------------------
# Provider Options:
#   - mock   : 100% Free local simulated SMS provider (zero costs, no accounts needed)
#   - twilio : Paid/Trial Twilio REST API provider
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_32_character_twilio_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Verified Test Mobile Number (Strict whitelist for test dispatches)
# Example: +919876543210 (Must match the number verified in your Twilio Console)
ADMIN_TEST_PHONE_NUMBER=+91xxxxxxxxxx

# Safety & Rate Limits
# - DEMO_MODE: Prepend [FLOODGUARD DEMO TEST] to all SMS messages
# - ENABLE_COMMUNITY_BROADCAST: Locked to False to prevent accidental mass messaging
# - MAX_DAILY_TEST_SMS: Hard cap on test SMS per day
# - SMS_COOLDOWN_SECONDS: Minimum interval between test dispatches
DEMO_MODE=True
ENABLE_COMMUNITY_BROADCAST=False
MAX_DAILY_TEST_SMS=5
SMS_COOLDOWN_SECONDS=60
